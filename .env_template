#NOTE QUE ESSE ARQUIVO NAO É OFICIAL, LOGO NAO ESTA SENDO UTILIZADO EM NENHUM LUGAR.

#PARA SUA UTILIZACAO RECOMENDO QUE TROQUE O NOME DESTE ARQUIVO PARA ".env" E SUBSTITUA O ROOT_USER E ROOT_PASSWORD POR USUARIOS E SENHAS DA SUA PREFERENCIA. 

#A SUBSTITUICAO NÃO AFETARÁ A FUNCIONALIDADE DO APLICATIVO UMA VEZ QUE AS DEPENDENCIAS DESSE ARQUIVO JÁ ESTAO PARAMETRIZADAS

# Credenciais de acesso ao MinIO
MINIO_ROOT_USER=rootuser
MINIO_ROOT_PASSWORD=rootpassword123

MINIO_ACCESS_KEY=rootuser
MINIO_SECRET_KEY=rootpassword123